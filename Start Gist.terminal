<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CommandString</key>
	<string>/bin/zsh -lic 'cd ~/Desktop/Gist || exit; lsof -ti tcp:8787 | xargs kill 2&gt;/dev/null; pkill -f "tunnel --url http://localhost:8787" 2&gt;/dev/null; sleep 0.5; : &gt; tunnel.log; if ! command -v node &gt;/dev/null; then echo "Node.js is not installed. Get it from https://nodejs.org and then double-click this again."; else (sleep 1; open http://localhost:8787) &amp; caffeinate -ims node --watch brain/brain.mjs serve; fi'</string>
	<key>RunCommandAsShell</key>
	<false/>
	<key>ProfileCurrentVersion</key>
	<real>2.07</real>
	<key>name</key>
	<string>Start Gist</string>
	<key>type</key>
	<string>Window Settings</string>
</dict>
</plist>
