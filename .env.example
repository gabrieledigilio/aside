# Optional overrides. The API key goes in key.txt, not here.
MODEL_BASE_URL=https://api.meta.ai/v1
# Headline lane: must answer in about a second.
FAST_MODEL=muse-ember-1.0
FAST_EFFORT=low
# Picture-and-question lane: the strongest model. muse-spark-1.3 costs about a third as much and is slower.
DEEP_MODEL=muse-wonder-1.0
DEEP_EFFORT=minimal
